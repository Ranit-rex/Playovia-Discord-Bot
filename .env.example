# Discord Developer Portal > Bot > Reset Token
DISCORD_BOT_TOKEN=

# Discord Developer Portal > General Information
DISCORD_APPLICATION_ID=

# Optional: restrict slash commands to one server during development
DISCORD_GUILD_ID=

# Comma-separated Discord user IDs allowed to run admin commands
DISCORD_ADMIN_IDS=

# Playovia backend base URL (configured later)
PLAYOVIA_API_URL=https://test-gameonix.onrender.com
PLAYOVIA_ADMIN_TOKEN=
