# Discord Developer Portal > Bot > Reset Token
DISCORD_BOT_TOKEN=

# Discord Developer Portal > General Information
DISCORD_APPLICATION_ID=

# Optional: restrict slash commands to one server during development
DISCORD_GUILD_ID=

# Comma-separated Discord user IDs allowed to run admin commands
DISCORD_ADMIN_IDS=

# Playovia backend connection
PLAYOVIA_API_URL=https://test-gameonix.onrender.com
# Set this same secret as DISCORD_INTEGRATION_TOKEN on the Playovia Render backend
PLAYOVIA_DISCORD_TOKEN=

# Discord channel ID where Playovia game activity logs and the live V2 dashboard are posted
DISCORD_GAME_LOG_CHANNEL_ID=
